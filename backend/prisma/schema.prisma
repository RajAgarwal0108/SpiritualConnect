generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
  engineType    = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password      String
  name          String
  role          Role      @default(USER)
  isPrivate     Boolean   @default(false)
  deactivatedAt DateTime?
  isVerified    Boolean   @default(false)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Guidance Feature Fields
  isGuide               Boolean           @default(false)
  guideStatus           GuideStatus       @default(NONE)
  phoneNumber           String?
  guideTitle            String?
  guideBio              String?
  guideApplication      GuideApplication?
  guidanceUserSessions  GuidanceSession[] @relation("GuidanceSeeker")
  guidanceGuideSessions GuidanceSession[] @relation("GuidanceGuide")
  GuidanceMessage       GuidanceMessage[]

  blogs              Blog[]
  blogComments       BlogComment[]
  bookmarks          Bookmark[]
  comments           Comment[]
  communities        CommunityMembership[]
  enrollments        CourseEnrollment[]
  following          Follow[]              @relation("following")
  followers          Follow[]              @relation("followers")
  likes              Like[]
  posts              Post[]
  profile            Profile?
  RefreshToken       RefreshToken[]
  reportsMade        Report[]              @relation("reporter")
  verificationTokens VerificationToken[]   @relation("UserVerificationTokens")
}

model Profile {
  id          Int      @id @default(autoincrement())
  bio         String?
  avatar      String?
  avatarType  String?  @default("custom")
  socialLinks Json?
  interests   String[]
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id])
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())
  follower    User     @relation("following", fields: [followerId], references: [id])
  following   User     @relation("followers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model Post {
  id          Int        @id @default(autoincrement())
  content     String
  media       String?
  status      String     @default("PUBLISHED")
  views       Int        @default(0)
  isDeleted   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  authorId    Int
  communityId Int
  bookmarks   Bookmark[]
  comments    Comment[]
  likes       Like[]
  author      User       @relation(fields: [authorId], references: [id])
  community   Community  @relation(fields: [communityId], references: [id])

  @@index([authorId])
  @@index([communityId])
  @@index([createdAt])
}

model Community {
  id          Int                   @id @default(autoincrement())
  name        String                @unique
  description String
  memberCount Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  members     CommunityMembership[]
  posts       Post[]
}

model CommunityMembership {
  id          Int       @id @default(autoincrement())
  userId      Int
  communityId Int
  role        String    @default("MEMBER")
  joinedAt    DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, communityId])
}

model Blog {
  id         Int           @id @default(autoincrement())
  title      String
  excerpt    String
  content    String
  category   String
  readTime   String
  coverImage String?
  authorId   Int
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  author     User          @relation(fields: [authorId], references: [id])
  comments   BlogComment[]
}

model BlogComment {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  blogId    Int
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
}

model Course {
  id          Int                @id @default(autoincrement())
  title       String
  description String
  instructor  String
  price       String             @default("Free")
  duration    String
  rating      Float              @default(5.0)
  thumbnail   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  enrollments CourseEnrollment[]
  modules     Module[]
}

model Module {
  id       Int      @id @default(autoincrement())
  title    String
  order    Int
  courseId Int
  lessons  Lesson[]
  course   Course   @relation(fields: [courseId], references: [id])
}

model Lesson {
  id       Int     @id @default(autoincrement())
  title    String
  content  String?
  videoUrl String?
  duration String?
  order    Int
  moduleId Int
  module   Module  @relation(fields: [moduleId], references: [id])
}

model CourseEnrollment {
  id       Int      @id @default(autoincrement())
  userId   Int
  courseId Int
  joinedAt DateTime @default(now())
  progress Float    @default(0.0)
  course   Course   @relation(fields: [courseId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
}

model Like {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model Bookmark {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model Comment {
  id        Int       @id @default(autoincrement())
  content   String
  createdAt DateTime  @default(now())
  postId    Int
  authorId  Int
  parentId  Int?
  author    User      @relation(fields: [authorId], references: [id])
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  post      Post      @relation(fields: [postId], references: [id])

  @@index([authorId])
  @@index([createdAt])
  @@index([parentId])
  @@index([postId])
}

model Report {
  id         Int      @id @default(autoincrement())
  reason     String
  targetType String
  targetId   Int
  reporterId Int
  createdAt  DateTime @default(now())
  status     String   @default("PENDING")
  reporter   User     @relation("reporter", fields: [reporterId], references: [id])
}

model Message {
  id         Int      @id @default(autoincrement())
  room       String
  senderId   Int
  senderName String
  content    String
  createdAt  DateTime @default(now())
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  type      String // "email_verification" | "password_reset"
  expiresAt DateTime
  used      Boolean  @default(false)

  userId Int
  user   User @relation("UserVerificationTokens", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum GuideStatus {
  PENDING
  APPROVED
  REJECTED
  NONE
}

enum SessionStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

model GuideApplication {
  id          String      @id @default(cuid())
  userId      Int         @unique
  reportText  String
  documentUrl String?
  status      GuideStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GuidanceSession {
  id              String            @id @default(cuid())
  userId          Int
  guideId         Int
  status          SessionStatus     @default(PENDING)
  isDetailsShared Boolean           @default(false)
  mood            String?           // Optional mood tracking at start
  goal            String?           // Core session intent
  summary         String?           // Post-session wisdom from guide
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation("GuidanceSeeker", fields: [userId], references: [id], onDelete: Cascade)
  guide           User              @relation("GuidanceGuide", fields: [guideId], references: [id], onDelete: Cascade)
  messages        GuidanceMessage[]

  @@unique([userId, guideId])
}

model GuidanceMessage {
  id        String          @id @default(cuid())
  sessionId String
  senderId  Int
  content   String
  type      String          @default("TEXT") // TEXT, ROUTINE, QUESTION, PROFILE_SHARE
  metadata  Json?           // Structured data for rich cards
  createdAt DateTime        @default(now())
  session   GuidanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender    User            @relation(fields: [senderId], references: [id], onDelete: Cascade)
}
